{
  "name": "devos-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.2.2",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit && vite build",
    "lint": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "test": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "storybook": "storybook dev -p 6006 --host 127.0.0.1",
    "storybook:build": "storybook build",
    "storybook:test": "concurrently -k -s first -n storybook,test \"storybook dev -p 6006 --host 127.0.0.1 --ci\" \"wait-on tcp:127.0.0.1:6006 && test-storybook --url http://127.0.0.1:6006\"",
    "e2e": "pnpm build && playwright test",
    "e2e:headed": "pnpm build && playwright test --headed",
    "e2e:ui": "pnpm build && playwright test --ui",
    "e2e:report": "playwright show-report",
    "mcp:playwright": "playwright-mcp --browser=chrome --caps=devtools --isolated --viewport-size=1365x900",
    "mcp:devtools": "chrome-devtools-mcp --isolated --viewport=1365x900 --no-usage-statistics"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@playwright/mcp": "^0.0.75",
    "@playwright/test": "^1.60.0",
    "@storybook/addon-a11y": "^10.4.1",
    "@storybook/react-vite": "^10.4.1",
    "@storybook/test-runner": "^0.24.4",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "axe-core": "^4.11.4",
    "chrome-devtools-mcp": "^1.1.0",
    "concurrently": "^9.2.1",
    "postcss": "^8.4.49",
    "storybook": "^10.4.1",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "wait-on": "^9.0.10"
  }
}
